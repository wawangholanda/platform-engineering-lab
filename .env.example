# =========================================================
# Local development environment
# Copy this file to .env and fill in your local values.
#
# IMPORTANT:
# .env must NEVER be committed.
# =========================================================

# ---------------------------------------------------------
# SSH
# ---------------------------------------------------------

export TF_VAR_ssh_public_key="$(cat "$HOME/.ssh/id_rsa.pub")"
export TF_VAR_cloud_init_password="CHANGE_ME"

# ---------------------------------------------------------
# Proxmox
# ---------------------------------------------------------

export TF_VAR_proxmox_api_url="https://192.168.1.10:8006/api2/json"
export TF_VAR_proxmox_api_token_id="terraform-prov@pve!terraform"
export TF_VAR_proxmox_api_token_secret="CHANGE_ME"

# ---------------------------------------------------------
# Kubernetes / Keepalived
# ---------------------------------------------------------

export KEEPALIVED_AUTH_PASS="CHANGE_ME"

# ---------------------------------------------------------
# Telegram Alertmanager Notifications (optional)
# ---------------------------------------------------------

export TELEGRAM_BOT_TOKEN=""
export TELEGRAM_CHAT_ID=""
