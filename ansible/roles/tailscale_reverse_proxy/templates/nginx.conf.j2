# WebSocket connection handling.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Reject unknown hostnames before proxying to private applications.
server {
    listen {{ tailscale_reverse_proxy_bind_address }}:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# Managed by Ansible: tailscale_reverse_proxy

server {
    listen {{ tailscale_reverse_proxy_bind_address }}:443 ssl;
    server_name {{ argocd_domain }};

    ssl_certificate     {{ tailscale_reverse_proxy_certificate_directory }}/fullchain.pem;
    ssl_certificate_key {{ tailscale_reverse_proxy_certificate_directory }}/privkey.pem;

    location / {
        proxy_pass http://{{ tailscale_reverse_proxy_upstream_address }}:{{ tailscale_reverse_proxy_upstream_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}

server {
    listen {{ tailscale_reverse_proxy_bind_address }}:443 ssl;
    server_name {{ grafana_domain }};

    ssl_certificate     {{ tailscale_reverse_proxy_certificate_directory }}/fullchain.pem;
