---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd-route
  namespace: default
spec:
  parentRefs:
    - name: nginx-gateway
  hostnames:
    - {{ARGOCD_DOMAIN}}
  rules:
    - backendRefs:
        - name: argocd-server
          namespace: argocd
          port: 80
